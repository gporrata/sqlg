#!/usr/bin/env node

import { spawn, spawnSync } from "node:child_process";
import { dirname } from "node:path";
import { fileURLToPath } from "node:url";

const [command, ...args] = process.argv.slice(2);
const yarn = process.platform === "win32" ? "yarn.cmd" : "yarn";
const appRoot = dirname(fileURLToPath(import.meta.url));

function run(script, scriptArgs = []) {
  const result = spawnSync(yarn, ["run", script, ...scriptArgs], { cwd: appRoot, stdio: "inherit" });
  process.exit(result.status ?? 1);
}

if (!command) {
  const child = spawn(yarn, ["run", "electron:dev"], {
    cwd: appRoot,
    detached: true,
    stdio: "ignore",
  });
  child.unref();
  console.log("sqlg started");
  process.exit(0);
}

if (["add", "list", "remove"].includes(command)) {
  run(`connection:${command}`, args);
}

console.error(`Unknown command: ${command}`);
console.error("Usage: sqlg [add|list|remove]");
process.exit(1);
