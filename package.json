{
  "name": "sqlg",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "main": "electron/main.cjs",
  "bin": {
    "sqlg": "./sqlg"
  },
  "packageManager": "yarn@1.22.22",
  "type": "module",
  "scripts": {
    "connection:add": "node scripts/connections.cjs add",
    "connection:list": "node scripts/connections.cjs list",
    "connection:remove": "node scripts/connections.cjs remove",
    "electron": "wait-on tcp:5173 && electron .",
    "electron:dev": "concurrently -k \"yarn dev\" \"yarn electron\"",
    "build": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "TS_NODE_PROJECT=tests/e2e/tsconfig.json wdio run tests/e2e/wdio.conf.ts"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "^10.0.0",
    "electron": "^42.3.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.1.1",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3",
    "vite": "^5.0.3",
    "wait-on": "^9.0.10"
  },
  "dependencies": {
    "@codemirror/commands": "^6.6.0",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/state": "^6.4.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.34.0",
    "codemirror": "^6.0.1",
    "lucide-react": "^1.17.0",
    "mysql2": "^3.22.4",
    "pg": "^8.21.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  }
}
